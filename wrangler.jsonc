{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "framevault",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js APIs (required for pg TCP connections and bcryptjs)
    "nodejs_compat",
    // Required for fetch() in Workers
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference so the Worker can call itself (needed by OpenNext)
      "binding": "WORKER_SELF_REFERENCE",
      "service": "framevault"
    }
  ]
  // Environment variables / secrets are set in:
  //   Production → Cloudflare dashboard (Workers & Pages → Settings → Variables)
  //   Local dev  → .dev.vars file (gitignored)
}
